# Copy this file to .env and fill in real values. .env is git-ignored.

# PostgreSQL 15+ with the pgvector extension.
# Neon: dashboard -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Offline alternative: run `npm run db:local` in a separate terminal and use this line instead:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# Secret used to sign login session tokens (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
